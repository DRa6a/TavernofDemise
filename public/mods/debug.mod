{
  "format": "tavern-mod",
  "formatVersion": 1,
  "manifest": {
    "id": "debug",
    "name": "调试模组",
    "version": "0.1.0",
    "author": "base",
    "description": "把基座原来硬编码的「调试面板」迁出为 mod。提供：翻开所有牌 / 减少手牌 / 替换手牌相位。",
    "tags": ["debug", "dev"]
  },
  "info": "# 调试模组\n\n仅供开发期使用。注入一个「调试」按钮到游戏 header，点击展开后可以：\n- 开关「翻开所有牌」\n- 减少一张手牌\n- 把每张手牌替换为「天/地/人/道」\n\n基座不预装此 mod——通过「加载调试 mod」按钮启用。\n",
  "data": {
    "abilities": [],
    "states": []
  },
  "script": "function setup(api) {\n  var h = api.h;\n  var open = false;\n  var PHASES = ['天', '地', '人', '道'];\n\n  function rerender() { api.debug.bumpRender(); }\n  function toggleOpen() { open = !open; rerender(); }\n\n  function setReveal(value) {\n    api.debug.setRevealAll(value);\n    rerender();\n  }\n\n  function removeOne(playerId) {\n    api.debug.modifyHand(playerId, 'remove');\n    rerender();\n  }\n\n  function replacePhase(playerId, card, phase) {\n    var newCard = { id: card.id, phase: phase, zodiac: card.zodiac };\n    api.debug.modifyHand(playerId, { replaceId: card.id, newCard: newCard });\n    rerender();\n  }\n\n  function stop(ev) { ev.stopPropagation(); }\n\n  api.ui.register('game:header-extra', function (ctx) {\n    var reveal = api.debug.isRevealAll();\n    var human = ctx.humanPlayer;\n\n    var children = [\n      h('button', {\n        key: 'toggle',\n        type: 'button',\n        className: 'btn-text',\n        onClick: toggleOpen,\n        title: '调试面板（debug mod）',\n      }, '调试')\n    ];\n\n    if (open) {\n      var drawerChildren = [];\n\n      drawerChildren.push(\n        h('div', { key: 'reveal', className: 'debug-row' },\n          h('label', { className: 'debug-toggle' },\n            h('input', {\n              type: 'checkbox',\n              checked: reveal,\n              onChange: function (e) { setReveal(e.target.checked); },\n            }),\n            h('span', null, '取消隐牌面（翻开所有牌）')\n          )\n        )\n      );\n\n      if (human) {\n        drawerChildren.push(\n          h('div', { key: 'remove', className: 'debug-row' },\n            h('button', {\n              type: 'button',\n              className: 'btn-secondary',\n              disabled: !human.hand || human.hand.length === 0,\n              onClick: function () { removeOne(human.id); },\n            }, '减少一张手牌')\n          )\n        );\n\n        drawerChildren.push(\n          h('div', { key: 'replace', className: 'debug-row' },\n            h('span', null, '替换手牌为：'),\n            h('div', { className: 'debug-card-grid' },\n              (human.hand || []).map(function (card) {\n                return h('div', { key: card.id, className: 'debug-card-group' },\n                  h('span', { className: 'debug-card-id' }, card.phase),\n                  h('div', { className: 'debug-phase-buttons' },\n                    PHASES.map(function (phase) {\n                      return h('button', {\n                        key: phase,\n                        type: 'button',\n                        className: 'btn-text',\n                        onClick: function () { replacePhase(human.id, card, phase); },\n                      }, phase);\n                    })\n                  )\n                );\n              })\n            )\n          )\n        );\n      } else {\n        drawerChildren.push(\n          h('div', { key: 'noplayer', className: 'debug-row' },\n            h('span', null, '（对局尚未开始，无人类玩家）')\n          )\n        );\n      }\n\n      children.push(\n        h('div', { key: 'drawer', className: 'debug-drawer', onClick: stop },\n          drawerChildren\n        )\n      );\n    }\n\n    return h('div', { className: 'debug-panel' }, children);\n  });\n\n  api.log('debug mod loaded');\n}\n\nfunction teardown() {\n  /* mod 卸载时由基座清理 ui.register，无需手动 unregister */\n}\n"
}
